#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'Usage: %s <plugin-version>\n' "$0" >&2
    exit 2
fi

plugin_root="$HOME/.codex/plugins/cache/context-mode/context-mode/$1"
if [[ ! -d "$plugin_root" ]]; then
    printf 'Context Mode plugin cache not found: %s\n' "$plugin_root" >&2
    exit 1
fi

while IFS= read -r -d '' link; do
    if ! target="$(realpath "$link" 2>/dev/null)"; then
        rm "$link"
        continue
    fi
    if [[ ! -f "$target" || ! -x "$target" ]]; then
        printf 'Unsupported plugin symlink target: %s\n' "$link" >&2
        exit 1
    fi

    replacement="$(mktemp "${link}.XXXXXX")"
    printf '#!/bin/bash\nexec %q "$@"\n' "$target" > "$replacement"
    chmod +x "$replacement"
    mv -f "$replacement" "$link"
done < <(find "$plugin_root" -type l -print0)
