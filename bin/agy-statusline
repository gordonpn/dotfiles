#!/usr/bin/env bash
# Antigravity CLI status line generator.
# Reads runtime telemetry JSON from stdin and formats:
# workspace.current_dir | model.display_name | ctx: <used>% | quota: <remaining>%

set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
    exit 0
fi

input=$(cat)

if [[ -z "$input" ]]; then
    exit 0
fi

printf '%s\n' "$input" | jq -r --arg home "${HOME:-}" '
  def shorten_home:
    if $home != "" and . == $home then
      "~"
    elif $home != "" and startswith($home + "/") then
      "~" + .[($home | length):]
    else
      .
    end;

  def get_quota_fraction:
    if .quota == null then
      null
    elif (.quota | type) == "number" then
      .quota
    elif (.quota | type) == "object" and (.quota.remaining_fraction != null) then
      .quota.remaining_fraction
    elif (.quota | type) == "object" then
      (.model.display_name // .model.id // "" | ascii_downcase) as $m |
      if ($m | contains("gemini")) then
        ([.quota["gemini-5h"].remaining_fraction, .quota["gemini-weekly"].remaining_fraction] | map(select(. != null)) | min) // ([.quota[] | .remaining_fraction? | select(. != null)] | min)
      elif ($m | (contains("claude") or contains("3p") or contains("gpt") or contains("anthropic"))) then
        ([.quota["3p-5h"].remaining_fraction, .quota["3p-weekly"].remaining_fraction] | map(select(. != null)) | min) // ([.quota[] | .remaining_fraction? | select(. != null)] | min)
      else
        ([.quota[] | .remaining_fraction? | select(. != null)] | min)
      end
    else
      null
    end;

  (try (.workspace.current_dir // .cwd // "" | shorten_home) catch "") as $dir |
  (try (.model.display_name // .model.id // "") catch "") as $model |
  (try (if .context_window.used_percentage != null then "ctx: \(.context_window.used_percentage | round)%" else null end) catch null) as $ctx |
  (try (get_quota_fraction | if . != null then "quota: \((. * 100) | round)%" else null end) catch null) as $quota |

  [$dir, $model, $ctx, $quota] | map(select(. != null and . != "")) | join(" | ")
' 2>/dev/null || true
