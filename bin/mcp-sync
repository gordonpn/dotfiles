#!/usr/bin/env bash
# mcp-sync: Synchronize, hydrate, and maintain agent parity across Antigravity and Codex
# Pulls sensitive tokens from OS Keychain / secret store or environment variables.
# Synchronizes MCP server configurations, shared skills, and AGENTS.md instructions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
MCP_SYNC_PY="${REPO_DIR}/scripts/mcp_sync.py"
TEMPLATE_DIR="${REPO_DIR}/dotfiles/gemini"
GEMINI_DIR="${HOME}/.gemini"
GEMINI_CONFIG_DIR="${GEMINI_DIR}/config"
CODEX_DIR="${HOME}/.codex"
OPENCODE_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/opencode"
COPILOT_DIR="${COPILOT_DIR:-${COPILOT_HOME:-${HOME}/.copilot}}"
KUBE_DIR="${HOME}/.kube"
LOCAL_BIN_DIR="${HOME}/.local/bin"
LOCK_DIR="${GEMINI_DIR}/.mcp-sync.lock"

# github-mcp-server ships as a Go binary, not on npm or PyPI, so it is fetched
# from GitHub releases. Pinned for reproducibility; override to bump.
GITHUB_MCP_SERVER_VERSION="${GITHUB_MCP_SERVER_VERSION:-1.12.1}"
CODEBASE_MEMORY_MCP_VERSION="0.11.0"
SONARQUBE_MCP_SERVER_VERSION="1.28.0.4397"
AI_MEMORY_VERSION="${AI_MEMORY_VERSION:-3.2.9}"

mkdir -p "${GEMINI_DIR}" "${GEMINI_CONFIG_DIR}" "${CODEX_DIR}" "${KUBE_DIR}" "${LOCAL_BIN_DIR}"

get_secret() {
  local service_name="$1"
  local env_var_name="$2"
  local value="${!env_var_name:-}"

  if [[ -n "${value}" ]]; then
    echo "${value}"
    return 0
  fi

  if [[ "${OSTYPE:-}" == "darwin"* ]] && command -v security >/dev/null 2>&1; then
    value="$(security find-generic-password -a "${USER}" -s "${service_name}" -w 2>/dev/null || true)"
  elif command -v secret-tool >/dev/null 2>&1; then
    value="$(secret-tool lookup service "${service_name}" 2>/dev/null || true)"
  fi

  echo "${value}"
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

install_github_mcp_server() {
  local bin_path="${LOCAL_BIN_DIR}/github-mcp-server"
  # Stamp file rather than `--version`: the release binary's flag output format
  # is not part of its contract, the stamp is ours.
  local stamp_file="${LOCAL_BIN_DIR}/.github-mcp-server.version"
  local want="${GITHUB_MCP_SERVER_VERSION}"

  if [[ -x "${bin_path}" && -f "${stamp_file}" ]] && [[ "$(cat "${stamp_file}")" == "${want}" ]]; then
    echo "github-mcp-server ${want} already present at ${bin_path}"
    return 0
  fi

  local os arch
  case "$(uname -s)" in
    Darwin) os="Darwin" ;;
    Linux) os="Linux" ;;
    *) echo "Notice: unsupported OS $(uname -s), skipping github-mcp-server install."; return 0 ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) arch="x86_64" ;;
    arm64 | aarch64) arch="arm64" ;;
    *) echo "Notice: unsupported arch $(uname -m), skipping github-mcp-server install."; return 0 ;;
  esac

  local asset="github-mcp-server_${os}_${arch}.tar.gz"
  local base="https://github.com/github/github-mcp-server/releases/download/v${want}"
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '${tmp_dir}'" RETURN

  echo "Downloading github-mcp-server ${want} (${os}/${arch})..."
  if ! curl -fsSL -o "${tmp_dir}/${asset}" "${base}/${asset}"; then
    echo "Notice: download of ${asset} failed, leaving github-mcp-server unchanged." >&2
    return 0
  fi
  if ! curl -fsSL -o "${tmp_dir}/checksums.txt" "${base}/github-mcp-server_${want}_checksums.txt"; then
    echo "Notice: checksum file unavailable, refusing to install unverified binary." >&2
    return 0
  fi

  local expected actual
  expected="$(awk -v a="${asset}" '$2 == a {print $1}' "${tmp_dir}/checksums.txt")"
  actual="$(sha256_of "${tmp_dir}/${asset}")"
  if [[ -z "${expected}" || "${expected}" != "${actual}" ]]; then
    echo "Error: checksum mismatch for ${asset} (expected '${expected}', got '${actual}')." >&2
    return 1
  fi

  tar -xzf "${tmp_dir}/${asset}" -C "${tmp_dir}" github-mcp-server
  install -m 755 "${tmp_dir}/github-mcp-server" "${bin_path}"
  echo "${want}" >"${stamp_file}"
  echo "Installed github-mcp-server ${want} to ${bin_path}"
}

install_codebase_memory_mcp() (
  local install_dir="${HOME}/.local/share/codebase-memory-mcp"
  local bin_path="${install_dir}/codebase-memory-mcp"
  local stamp_file="${install_dir}/.version"
  local want="${CODEBASE_MEMORY_MCP_VERSION}"

  if [[ -x "${bin_path}" && -f "${stamp_file}" ]] && [[ "$(cat "${stamp_file}")" == "${want}" ]]; then
    echo "codebase-memory-mcp ${want} already present at ${bin_path}"
    return 0
  fi

  local tmp_dir
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT

  local os arch
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) echo "Unsupported OS for codebase-memory-mcp" >&2; return 1 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=amd64 ;;
    *) echo "Unsupported architecture for codebase-memory-mcp" >&2; return 1 ;;
  esac
  local asset="codebase-memory-mcp-${os}-${arch}"
  [[ "${os}" != linux ]] || asset+="-portable"
  asset+=".tar.gz"
  local base="https://github.com/DeusData/codebase-memory-mcp/releases/download/v${want}"

  # The upstream installer also edits shell startup files, even with --skip-config.
  curl -fsSL --proto '=https' -o "${tmp_dir}/${asset}" "${base}/${asset}" || return
  curl -fsSL --proto '=https' -o "${tmp_dir}/checksums.txt" "${base}/checksums.txt" || return
  local expected actual
  expected="$(awk -v a="${asset}" '$2 == a {print $1}' "${tmp_dir}/checksums.txt")"
  actual="$(sha256_of "${tmp_dir}/${asset}")"
  if [[ -z "${expected}" || "${expected}" != "${actual}" ]]; then
    echo "Checksum mismatch for ${asset}; leaving codebase-memory-mcp unchanged" >&2
    return 1
  fi
  tar -xzf "${tmp_dir}/${asset}" -C "${tmp_dir}" codebase-memory-mcp || return
  if [[ "${os}" == darwin ]]; then
    codesign --force --sign - "${tmp_dir}/codebase-memory-mcp" || return
  fi
  mkdir -p "${install_dir}"
  install -m 755 "${tmp_dir}/codebase-memory-mcp" "${bin_path}" || return
  "${bin_path}" --version || return
  echo "${want}" >"${stamp_file}"
)

install_terraform_mcp_server() {
  local bin_path="${LOCAL_BIN_DIR}/terraform-mcp-server"

  if command -v terraform-mcp-server >/dev/null 2>&1; then
    local installed_path
    installed_path="$(command -v terraform-mcp-server)"
    if [[ "${installed_path}" != "${bin_path}" && ! -e "${bin_path}" ]]; then
      ln -sf "${installed_path}" "${bin_path}"
    fi
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "Installing terraform-mcp-server via Homebrew..."
    brew install terraform-mcp-server
    ln -sf "$(command -v terraform-mcp-server)" "${bin_path}"
    return 0
  fi

  if command -v go >/dev/null 2>&1; then
    echo "Installing terraform-mcp-server via go install..."
    GOBIN="${LOCAL_BIN_DIR}" go install github.com/hashicorp/terraform-mcp-server/cmd/terraform-mcp-server@latest
    return 0
  fi

  echo "Notice: terraform-mcp-server not found and neither brew nor go is available to install it." >&2
}

install_repomix() {
  local bin_path="${LOCAL_BIN_DIR}/repomix"

  if command -v repomix >/dev/null 2>&1; then
    local installed_path
    installed_path="$(command -v repomix)"
    if [[ "${installed_path}" != "${bin_path}" && ! -e "${bin_path}" ]]; then
      ln -sf "${installed_path}" "${bin_path}"
    fi
    return 0
  fi

  if command -v npm >/dev/null 2>&1; then
    echo "Installing repomix via npm..."
    npm install -g repomix
    if command -v repomix >/dev/null 2>&1; then
      ln -sf "$(command -v repomix)" "${bin_path}"
    fi
    return 0
  fi

  echo "Notice: repomix not found and npm is unavailable to install it." >&2
}

install_semgrep() {
  local bin_path="${LOCAL_BIN_DIR}/semgrep"

  if [[ -x "${bin_path}" ]]; then
    return 0
  fi

  if command -v uv >/dev/null 2>&1; then
    echo "Installing semgrep via uv tool..."
    uv tool install semgrep
    return 0
  fi

  echo "Notice: semgrep not found and uv is unavailable to install it." >&2
}

install_sonarqube_mcp_server() {
  local install_dir="${HOME}/.local/share/sonarqube-mcp-server"
  local jar_path="${install_dir}/sonarqube-mcp-server.jar"
  local stamp_file="${install_dir}/.version"
  local want="${SONARQUBE_MCP_SERVER_VERSION}"

  if [[ -f "${jar_path}" && -f "${stamp_file}" ]] && [[ "$(<"${stamp_file}")" == "${want}" ]]; then
    return 0
  fi

  local versioned_jar="${install_dir}/sonarqube-mcp-server-${want}.jar"
  local url="https://binaries.sonarsource.com/Distribution/sonarqube-mcp-server/sonarqube-mcp-server-${want}.jar"
  mkdir -p "${install_dir}"

  echo "Downloading sonarqube-mcp-server ${want}..."
  if curl -fsSL -o "${versioned_jar}" "${url}"; then
    ln -sfn "${versioned_jar}" "${jar_path}"
    echo "${want}" > "${stamp_file}"
    echo "Installed sonarqube-mcp-server ${want} to ${jar_path}"
  else
    echo "Notice: download of sonarqube-mcp-server ${want} failed." >&2
  fi
}

install_ai_memory() (
  local bin_path="${LOCAL_BIN_DIR}/ai-memory"
  local stamp_file="${LOCAL_BIN_DIR}/.ai-memory.version"
  local hooks_dir="${HOME}/.local/share/ai-memory/hooks"
  local want="${AI_MEMORY_VERSION}"

  if [[ -x "${bin_path}" && -f "${stamp_file}" ]] && [[ "$(<"${stamp_file}")" == "${want}" ]]; then
    return 0
  fi

  if [[ -x "${bin_path}" ]]; then
    local current_version
    current_version="$("${bin_path}" --version 2>/dev/null | awk '{print $2}' || true)"
    if [[ "${current_version}" == "${want}" ]]; then
      echo "${want}" >"${stamp_file}"
      return 0
    fi
  fi

  local os arch
  case "$(uname -s)" in
    Darwin) os="macos" ;;
    Linux) os="linux" ;;
    *) echo "Notice: unsupported OS $(uname -s), skipping ai-memory install." >&2; return 0 ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch="aarch64" ;;
    x86_64|amd64) arch="x86_64" ;;
    *) echo "Notice: unsupported architecture $(uname -m), skipping ai-memory install." >&2; return 0 ;;
  esac

  local asset="ai-memory-${os}-${arch}.tar.gz"
  local base="https://github.com/akitaonrails/ai-memory/releases/download/v${want}"
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT

  echo "Downloading ai-memory ${want} (${os}/${arch})..."
  if ! curl -fsSL --proto '=https' -o "${tmp_dir}/${asset}" "${base}/${asset}"; then
    echo "Notice: download of ${asset} failed, leaving ai-memory unchanged." >&2
    return 0
  fi
  if ! curl -fsSL --proto '=https' -o "${tmp_dir}/${asset}.sha256" "${base}/${asset}.sha256"; then
    echo "Notice: checksum file for ${asset} unavailable, refusing to install unverified binary." >&2
    return 0
  fi

  local expected actual
  expected="$(awk '{print $1}' "${tmp_dir}/${asset}.sha256")"
  actual="$(sha256_of "${tmp_dir}/${asset}")"
  if [[ -z "${expected}" || "${expected}" != "${actual}" ]]; then
    echo "Error: checksum mismatch for ${asset} (expected '${expected}', got '${actual}')." >&2
    return 1
  fi

  tar -xzf "${tmp_dir}/${asset}" -C "${tmp_dir}" ai-memory || return 1
  if [[ "$(uname -s)" == Darwin ]]; then
    codesign --force --sign - "${tmp_dir}/ai-memory" || true
  fi
  install -m 755 "${tmp_dir}/ai-memory" "${bin_path}" || return 1

  # Download and unpack hooks if absent
  if [[ ! -d "${hooks_dir}" ]]; then
    local hooks_asset="ai-memory-hooks.tar.gz"
    if curl -fsSL --proto '=https' -o "${tmp_dir}/${hooks_asset}" "${base}/${hooks_asset}" && \
       curl -fsSL --proto '=https' -o "${tmp_dir}/${hooks_asset}.sha256" "${base}/${hooks_asset}.sha256"; then
      local exp_hooks act_hooks
      exp_hooks="$(awk '{print $1}' "${tmp_dir}/${hooks_asset}.sha256")"
      act_hooks="$(sha256_of "${tmp_dir}/${hooks_asset}")"
      if [[ -n "${exp_hooks}" && "${exp_hooks}" == "${act_hooks}" ]]; then
        mkdir -p "${HOME}/.local/share/ai-memory"
        tar -xzf "${tmp_dir}/${hooks_asset}" -C "${HOME}/.local/share/ai-memory"
      else
        echo "Notice: hooks archive checksum mismatch for ai-memory, skipping hooks install." >&2
      fi
    else
      echo "Notice: hooks archive download for ai-memory failed, skipping hooks install." >&2
    fi
  fi

  echo "${want}" >"${stamp_file}"
  echo "Installed ai-memory ${want} to ${bin_path}"
)

install_thinking_skills() {
  local target_dir="${HOME}/.local/share/cc-thinking-skills"
  if [[ -d "${target_dir}/.git" ]]; then
    return 0
  fi
  if command -v git >/dev/null 2>&1; then
    echo "Cloning cc-thinking-skills..."
    git clone --depth 1 https://github.com/tjboudreaux/cc-thinking-skills.git "${target_dir}" 2>/dev/null || {
      echo "Notice: could not clone cc-thinking-skills, skipping." >&2
      return 0
    }
  fi
}

sync_ssh_profiles() {
  python3 "${MCP_SYNC_PY}" sync-ssh-profiles \
    --ssh-config "${HOME}/.ssh/config" \
    --target "${GEMINI_DIR}/ssh-profiles.json"
}

sync_docker_profiles() {
  python3 "${MCP_SYNC_PY}" sync-docker-profiles \
    --ssh-profiles "${GEMINI_DIR}/ssh-profiles.json" \
    --target "${GEMINI_DIR}/docker-profiles.json"
}

sync_k3s_cluster() {
  python3 "${MCP_SYNC_PY}" sync-k3s --home "${HOME}"
}

sync_mcp_config() {
  local template_file="${TEMPLATE_DIR}/mcp_config.template.json"
  local target_file="${GEMINI_CONFIG_DIR}/mcp_config.json"
  local codex_config="${CODEX_DIR}/config.toml"
  local opencode_config="${OPENCODE_DIR}/opencode.json"
  local copilot_config="${COPILOT_DIR}/mcp-config.json"

  if [[ ! -f "${template_file}" ]]; then
    echo "Error: Template ${template_file} not found." >&2
    exit 1
  fi

  # Resolve tokens and URLs
  local gh_token
  gh_token="$(get_secret "github_token" "GITHUB_PERSONAL_ACCESS_TOKEN")"
  if [[ -z "${gh_token}" ]] && command -v gh >/dev/null 2>&1; then
    gh_token="$(gh auth token 2>/dev/null || true)"
  fi

  local brave_key
  brave_key="$(get_secret "brave_api_key" "BRAVE_API_KEY")"

  local exa_key
  exa_key="$(get_secret "exa_api_key" "EXA_API_KEY")"

  local ts_key
  ts_key="$(get_secret "tailscale_api_key" "TAILSCALE_API_KEY")"

  local kuma_jwt
  kuma_jwt="$(get_secret "uptime_kuma_jwt" "UPTIME_KUMA_JWT_TOKEN")"

  local hc_key
  hc_key="$(get_secret "healthchecks_api_key" "HEALTHCHECKS_API_KEY")"

  local cf_account
  cf_account="${CLOUDFLARE_ACCOUNT_ID:-75520e73ba21df12b124d81e80ad29c1}"

  local cf_token
  cf_token="$(get_secret "cloudflare_api_token" "CLOUDFLARE_API_TOKEN")"

  local prom_url
  prom_url="${PROMETHEUS_URL:-http://master.tailb65f8c.ts.net:30090}"

  local loki_url
  loki_url="${LOKI_URL:-http://master.tailb65f8c.ts.net:31100}"

  local kuma_url
  kuma_url="${UPTIME_KUMA_URL:-https://p01--uptime-kuma--m5z2j5q8x7zn.code.run}"

  local sqlite_db
  sqlite_db="${SQLITE_DB_PATH:-${HOME}/workspace/anime-recommendation/anime.db}"

  local caddy_url
  caddy_url="${CADDY_ADMIN_URL:-http://master.tailb65f8c.ts.net:2019}"

  local postgres_url
  postgres_url="${POSTGRES_URL:-postgresql://postgres:postgres@localhost:5432/postgres}"

  local redis_url
  redis_url="${REDIS_URL:-redis://localhost:6379}"

  local vault_addr
  vault_addr="${VAULT_ADDR:-http://master.tailb65f8c.ts.net:8200}"

  local vault_token
  vault_token="$(get_secret "vault_token" "VAULT_TOKEN")"

  local slack_token
  slack_token="$(get_secret "slack_bot_token" "SLACK_BOT_TOKEN")"

  local slack_team
  slack_team="${SLACK_TEAM_ID:-TNF78N3N0}"

  local discord_token
  discord_token="$(get_secret "discord_token" "DISCORD_TOKEN")"

  local tfe_token
  tfe_token="$(get_secret "tfe_token" "TFE_TOKEN")"
  if [[ -z "${tfe_token}" ]]; then
    tfe_token="$(get_secret "terraform_token" "TERRAFORM_TOKEN")"
  fi

  local tfe_address
  tfe_address="${TFE_ADDRESS:-https://app.terraform.io}"

  local postman_key
  postman_key="$(get_secret "postman_api_key" "POSTMAN_API_KEY")"

  local sonar_token
  sonar_token="$(get_secret "sonarqube_token" "SONARQUBE_TOKEN")"

  local sonar_url
  sonar_url="${SONARQUBE_URL:-https://sonarcloud.io}"

  local sonar_org
  sonar_org="$(get_secret "sonarqube_org" "SONARQUBE_ORG")"

  export GITHUB_PERSONAL_ACCESS_TOKEN="${gh_token}"
  export BRAVE_API_KEY="${brave_key}"
  export EXA_API_KEY="${exa_key}"
  export TAILSCALE_API_KEY="${ts_key}"
  export UPTIME_KUMA_JWT_TOKEN="${kuma_jwt}"
  export HEALTHCHECKS_API_KEY="${hc_key}"
  export CLOUDFLARE_ACCOUNT_ID="${cf_account}"
  export CLOUDFLARE_API_TOKEN="${cf_token}"
  export PROMETHEUS_URL="${prom_url}"
  export LOKI_URL="${loki_url}"
  export UPTIME_KUMA_URL="${kuma_url}"
  export SQLITE_DB_PATH="${sqlite_db}"
  export CADDY_ADMIN_URL="${caddy_url}"
  export POSTGRES_URL="${postgres_url}"
  export REDIS_URL="${redis_url}"
  export VAULT_ADDR="${vault_addr}"
  export VAULT_TOKEN="${vault_token}"
  export SLACK_BOT_TOKEN="${slack_token}"
  export SLACK_TEAM_ID="${slack_team}"
  export DISCORD_TOKEN="${discord_token}"
  export TFE_TOKEN="${tfe_token}"
  export TFE_ADDRESS="${tfe_address}"
  export POSTMAN_API_KEY="${postman_key}"
  export SONARQUBE_TOKEN="${sonar_token}"
  export SONARQUBE_URL="${sonar_url}"
  export SONARQUBE_ORG="${sonar_org}"
  export CODEX_MCP_PROFILE="${CODEX_MCP_PROFILE:-minimal}"
  export CODEX_MCP_SERVERS="${CODEX_MCP_SERVERS:-}"
  export OPENCODE_MCP_PROFILE="${OPENCODE_MCP_PROFILE:-minimal}"
  export OPENCODE_MCP_SERVERS="${OPENCODE_MCP_SERVERS:-}"
  export COPILOT_MCP_PROFILE="${COPILOT_MCP_PROFILE:-minimal}"
  export COPILOT_MCP_SERVERS="${COPILOT_MCP_SERVERS:-}"

  python3 "${MCP_SYNC_PY}" sync-mcp-config \
    --template "${template_file}" \
    --antigravity "${target_file}" \
    --codex "${codex_config}" \
    --codex-template "${REPO_DIR}/dotfiles/codex/config.template.toml" \
    --opencode "${opencode_config}" \
    --copilot "${copilot_config}"
}

backup_with_collision_avoidance() {
  python3 "${MCP_SYNC_PY}" backup --src "$1" --base-dest "$2"
}

opencode_available() {
  command -v opencode >/dev/null 2>&1 || [[ -d "${OPENCODE_DIR}" ]]
}

copilot_available() {
  command -v copilot >/dev/null 2>&1 || [[ -d "${COPILOT_DIR}" ]]
}

sync_skills_and_instructions() {
  local opencode_enabled="${1:-}"
  local copilot_enabled="${2:-}"
  if [[ -z "${opencode_enabled}" ]]; then
    if opencode_available; then
      opencode_enabled=1
    else
      opencode_enabled=0
    fi
  fi
  if [[ -z "${copilot_enabled}" ]]; then
    if copilot_available; then
      copilot_enabled=1
    else
      copilot_enabled=0
    fi
  fi

  python3 "${MCP_SYNC_PY}" sync-skills \
    --home "${HOME}" \
    --repo-dir "${REPO_DIR}" \
    --gemini-dir "${GEMINI_DIR}" \
    --gemini-config-dir "${GEMINI_CONFIG_DIR}" \
    --codex-dir "${CODEX_DIR}" \
    --opencode-dir "${OPENCODE_DIR}" \
    --copilot-dir "${COPILOT_DIR}" \
    --local-bin-dir "${LOCAL_BIN_DIR}" \
    --opencode-enabled "${opencode_enabled}" \
    --copilot-enabled "${copilot_enabled}"
}

main() {
  local configs_only=0
  local codebase_memory_only=0
  while (( $# )); do
    case "$1" in
      --configs-only|--mcp-only)
        configs_only=1
        shift
        ;;
      --codebase-memory-only)
        configs_only=1
        codebase_memory_only=1
        shift
        ;;
      --codex-profile=*)
        export CODEX_MCP_PROFILE="${1#*=}"
        shift
        ;;
      --codex-profile)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "Error: --codex-profile requires a profile argument ('minimal' or 'full')" >&2
          exit 1
        fi
        export CODEX_MCP_PROFILE="$2"
        shift 2
        ;;
      --codex-servers=*)
        export CODEX_MCP_SERVERS="${1#*=}"
        shift
        ;;
      --codex-servers)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "Error: --codex-servers requires a comma-separated list of servers" >&2
          exit 1
        fi
        export CODEX_MCP_SERVERS="$2"
        shift 2
        ;;
      --opencode-profile=*)
        export OPENCODE_MCP_PROFILE="${1#*=}"
        shift
        ;;
      --opencode-profile)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "Error: --opencode-profile requires a profile argument ('minimal' or 'full')" >&2
          exit 1
        fi
        export OPENCODE_MCP_PROFILE="$2"
        shift 2
        ;;
      --opencode-servers=*)
        export OPENCODE_MCP_SERVERS="${1#*=}"
        shift
        ;;
      --opencode-servers)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "Error: --opencode-servers requires a comma-separated list of servers" >&2
          exit 1
        fi
        export OPENCODE_MCP_SERVERS="$2"
        shift 2
        ;;
      --copilot-profile=*)
        export COPILOT_MCP_PROFILE="${1#*=}"
        shift
        ;;
      --copilot-profile)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "Error: --copilot-profile requires a profile argument ('minimal' or 'full')" >&2
          exit 1
        fi
        export COPILOT_MCP_PROFILE="$2"
        shift 2
        ;;
      --copilot-servers=*)
        export COPILOT_MCP_SERVERS="${1#*=}"
        shift
        ;;
      --copilot-servers)
        if [[ $# -lt 2 || "$2" == --* ]]; then
          echo "Error: --copilot-servers requires a comma-separated list of servers" >&2
          exit 1
        fi
        export COPILOT_MCP_SERVERS="$2"
        shift 2
        ;;
      -h|--help)
        echo "Usage: mcp-sync [OPTIONS]"
        echo ""
        echo "Options:"
        echo "  --configs-only, --mcp-only       Synchronize configurations and skills without downloading binaries"
        echo "  --codebase-memory-only           Run only codebase-memory-mcp checks and configuration updates"
        echo "  --codex-profile <PROFILE>        Codex MCP profile: 'minimal' (default) or 'full'"
        echo "  --codex-servers <SERVERS>        Comma-separated list of MCP servers to enable in Codex"
        echo "  --opencode-profile <PROFILE>     OpenCode MCP profile: 'minimal' (default) or 'full'"
        echo "  --opencode-servers <SERVERS>     Comma-separated list of MCP servers to enable in OpenCode"
        echo "  --copilot-profile <PROFILE>      Copilot MCP profile: 'minimal' (default) or 'full'"
        echo "  --copilot-servers <SERVERS>      Comma-separated list of MCP servers to enable in Copilot"
        echo "  -h, --help                       Show this help message and exit"
        exit 0
        ;;
      *)
        shift
        ;;
    esac
  done

  # Atomic lock directory with PID tracking to prevent concurrent races
  if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
    local lock_pid=""
    if [[ -f "${LOCK_DIR}/pid" ]]; then
      lock_pid="$(cat "${LOCK_DIR}/pid" 2>/dev/null || true)"
    fi

    local is_active=0
    if [[ -n "${lock_pid}" ]] && kill -0 "${lock_pid}" 2>/dev/null; then
      if ps -p "${lock_pid}" -o command= 2>/dev/null | grep -q "mcp-sync"; then
        is_active=1
      fi
    fi

    if (( is_active )); then
      exit 0
    fi

    # Check lock mtime if pid was missing or dead
    local lock_mtime=0
    if [[ "${OSTYPE:-}" == "darwin"* ]]; then
      lock_mtime="$(stat -f %m "${LOCK_DIR}" 2>/dev/null || echo 0)"
    else
      lock_mtime="$(stat -c %Y "${LOCK_DIR}" 2>/dev/null || echo 0)"
    fi
    [[ "${lock_mtime}" =~ ^[0-9]+$ ]] || lock_mtime=0

    local now
    now="$(date +%s)"
    if (( now - lock_mtime > 60 )) || [[ -n "${lock_pid}" ]]; then
      local stale_dir="${LOCK_DIR}.stale.$$"
      if mv "${LOCK_DIR}" "${stale_dir}" 2>/dev/null; then
        rm -rf "${stale_dir}"
        mkdir "${LOCK_DIR}" 2>/dev/null || exit 0
      else
        exit 0
      fi
    else
      exit 0
    fi
  fi
  echo "$$" > "${LOCK_DIR}/pid"

  cleanup_lock() {
    if [[ -f "${LOCK_DIR}/pid" ]] && [[ "$(<"${LOCK_DIR}/pid")" == "$$" ]]; then
      rm -rf "${LOCK_DIR}"
    fi
  }
  trap cleanup_lock EXIT INT TERM

  echo "==> Synchronizing AI agent MCP and skills environment..."
  if (( ! configs_only || codebase_memory_only )); then
    install_codebase_memory_mcp
  fi
  if (( ! configs_only )); then
    install_ai_memory
    install_thinking_skills
    install_github_mcp_server
    install_terraform_mcp_server
    install_repomix
    install_semgrep
    install_sonarqube_mcp_server
  fi
  sync_ssh_profiles
  sync_docker_profiles
  if (( ! configs_only )); then
    sync_k3s_cluster
  fi
  local opencode_enabled=0
  local copilot_enabled=0
  if opencode_available; then
    opencode_enabled=1
  fi
  if copilot_available; then
    copilot_enabled=1
  fi
  sync_mcp_config
  sync_skills_and_instructions "${opencode_enabled}" "${copilot_enabled}"
  echo "==> Done. MCP configuration and agent parity ready."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
