# ~/.config/ghostty/config

# ---------------------------------------------------------------------
# Theme (Steph Ango's Flexoki Dark)
# ---------------------------------------------------------------------
theme = Flexoki Dark

background = #100F0F
foreground = #CECDC3
selection-background = #282726
selection-foreground = #CECDC3
cursor-color = #CECDC3

palette = 0=#100F0F
palette = 1=#AF3029
palette = 2=#66800B
palette = 3=#AD8301
palette = 4=#205EA6
palette = 5=#A02F6F
palette = 6=#24837B
palette = 7=#CECDC3
palette = 8=#6F6E69
palette = 9=#D14D41
palette = 10=#879A39
palette = 11=#D0A215
palette = 12=#4385BE
palette = 13=#CE5D97
palette = 14=#3AA99F
palette = 15=#FFFCF0

# ---------------------------------------------------------------------
# Typography (Parsed from your active iTerm2 profile)
# ---------------------------------------------------------------------
font-family = "JetBrainsMonoNFM-Regular"
font-size = 15
font-synthetic-style = true

# Thicken the text stroke weight slightly to counter macOS font anti-aliasing
font-thicken = true
font-thicken-strength = 120

# Add fine pixel adjustments to individual character cells
adjust-cell-width = 0
adjust-cell-height = 2

# Explicitly disable specific font ligatures if they interfere with code symbols 
# (e.g., disabling '==' transformations while keeping others active)
# font-feature = -calt

# ---------------------------------------------------------------------
# Window and Grid Geometry
# ---------------------------------------------------------------------
window-width = 80
window-height = 25
window-padding-x = 12
window-padding-y = 12

# Cosmetics & Layout (Enables clean native title bar tabs)
# Base Black to match Flexoki Dark canvas background
window-theme = "dark"
macos-titlebar-style = native

# ---------------------------------------------------------------------
# Interaction and Buffer Behavior
# ---------------------------------------------------------------------
# The maximum number of lines to keep in the scrollback buffer.
scrollback-limit = 1000000

# Increase scroll sensitivity for trackpads (precision) and mouse wheels (discrete)
mouse-scroll-multiplier = precision:2.0,discrete:3.0

# Static cursor rules (Bypasses shell integration switching)
cursor-style = block
cursor-style-blink = true

# Disable prompt confirmation when closing windows/tabs/quitting
confirm-close-surface = false

# ---------------------------------------------------------------------
# Clipboard and Key Mechanics
# ---------------------------------------------------------------------
mouse-hide-while-typing = true
macos-option-as-alt = left

# Automatically copy any mouse-selected text directly into the system clipboard
copy-on-select = clipboard

# Allow remote servers (via SSH) to write to your local macOS clipboard 
# using OSC 52 escape sequences (essential for copying text out of remote Neovim instances)
clipboard-read = allow
clipboard-write = allow

# ---------------------------------------------------------------------
# Cross-Platform Environment Sync (For Remote Server SSH Sessions)
# ---------------------------------------------------------------------
# Registers terminal info definitions and protects cursor geometry overrides
shell-integration-features = ssh-env,ssh-terminfo,no-cursor

# ---------------------------------------------------------------------
# Custom Keybindings
# ---------------------------------------------------------------------
# Seamlessly clear the prompt buffer to boot into your config layout via Neovim
keybind = super+,=text:\x1bqghostty +edit-config\x0d

# Force Shift+Backspace to send a literal Forward Delete over the wire
keybind = shift+backspace=text:\x1b[3~

# Switch tabs with Page Up / Page Down (bare, Cmd+, and Ctrl+)
keybind = page_up=previous_tab
keybind = page_down=next_tab
keybind = super+page_up=previous_tab
keybind = super+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
