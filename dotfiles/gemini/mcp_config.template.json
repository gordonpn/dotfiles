{
  "mcpServers": {
    "cclsp": {
      "command": "${HOME}/.local/share/pnpm/cclsp",
      "disabled": false,
      "env": {
        "CCLSP_CONFIG_PATH": "${HOME}/.config/cclsp/cclsp.json"
      }
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "puppeteer": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp==1.1.2",
        "mcp-server-sqlite",
        "--db-path",
        "${SQLITE_DB_PATH}"
      ]
    },
    "cloudflare": {
      "command": "npx",
      "args": [
        "-y",
        "@cloudflare/mcp-server-cloudflare",
        "run",
        "${CLOUDFLARE_ACCOUNT_ID}"
      ]
    },
    "prometheus": {
      "command": "npx",
      "args": ["-y", "prometheus-mcp@latest", "stdio"],
      "env": {
        "PROMETHEUS_URL": "${PROMETHEUS_URL}"
      }
    },
    "loki": {
      "command": "loki-mcp-server",
      "env": {
        "LOKI_URL": "${LOKI_URL}"
      }
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@hypnosis/docker-mcp-server"],
      "env": {
        "DOCKER_MCP_PROFILES_FILE": "${HOME}/.gemini/docker-profiles.json"
      }
    },
    "kubernetes": {
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes"],
      "env": {
        "KUBECONFIG": "${HOME}/.kube/config"
      }
    },
    "ssh": {
      "command": "npx",
      "args": ["-y", "@hypnosis/ssh-mcp-server"],
      "env": {
        "SSH_PROFILES_FILE": "${HOME}/.gemini/ssh-profiles.json"
      }
    },
    "tailscale": {
      "command": "npx",
      "args": ["-y", "@yawlabs/tailscale-mcp"],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}"
      }
    },
    "uptime-kuma": {
      "command": "npx",
      "args": ["-y", "@davidfuchs/mcp-uptime-kuma"],
      "env": {
        "UPTIME_KUMA_URL": "${UPTIME_KUMA_URL}",
        "UPTIME_KUMA_JWT_TOKEN": "${UPTIME_KUMA_JWT_TOKEN}"
      }
    },
    "healthchecks": {
      "command": "npx",
      "args": ["-y", "healthchecks-mcp"],
      "env": {
        "HEALTHCHECKS_API_KEY": "${HEALTHCHECKS_API_KEY}"
      }
    },
    "server-services-configs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${HOME}/workspace/server-services-configs"
      ]
    },
    "caddy": {
      "command": "npx",
      "args": ["-y", "@yawlabs/caddy-mcp"],
      "env": {
        "CADDY_ADMIN_URL": "${CADDY_ADMIN_URL}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${POSTGRES_URL}"
      ]
    },
    "redis": {
      "command": "npx",
      "args": ["-y", "@yawlabs/redis-mcp"],
      "env": {
        "REDIS_URL": "${REDIS_URL}"
      }
    },
    "vault": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mcp<2",
        "--with",
        "httpx",
        "${HOME}/workspace/dotfiles/bin/vault-mcp-server"
      ],
      "env": {
        "VAULT_ADDR": "${VAULT_ADDR}",
        "VAULT_TOKEN": "${VAULT_TOKEN}"
      }
    },
    "slack": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "discord": {
      "command": "npx",
      "args": ["-y", "@pasympa/discord-mcp"],
      "env": {
        "DISCORD_TOKEN": "${DISCORD_TOKEN}"
      }
    }
  }
}
