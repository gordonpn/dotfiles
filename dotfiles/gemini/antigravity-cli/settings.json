{
  "allowNonWorkspaceAccess": true,
  "altScreenMode": "never",
  "artifactReviewPolicy": "always-proceed",
  "copyOnSelect": true,
  "hideActiveItems": false,
  "max_concurrent_tasks": 1,
  "model": "Gemini 3.8 Flash (High)",
  "notifications": true,
  "runningLightSpeed": "slow",
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/agy-statusline",
    "enabled": true
  },
  "title": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/title.sh",
    "enabled": true
  },
  "toolPermission": "always-proceed",
  "verbosity": "high"
}
