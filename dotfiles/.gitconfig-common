# Shared git configuration for every machine (personal Mac, work Mac, cloud desktop).
#
# Included from each machine's ~/.gitconfig via:
#     [include]
#         path = ~/.gitconfig-common
#
# ~/.gitconfig-common is a symlink to this file. The include path is deliberately
# absolute (~/…) rather than relative: a relative include resolves against the
# directory of the *symlink*, not its target, which silently breaks.
#
# Machine-specific settings do NOT belong here — keep them in the per-machine
# .gitconfig: user.email, credential.helper, and the includeIf gitdir rules.
#
# Requires on PATH: delta, bat, difft, nvim.

[url "git@github.com:"]
    insteadOf = https://github.com/

[color]
ui = true

[color "diff"]
whitespace = red reverse

[core]
attributesfile = ~/.gitattributes
autocrlf = input
editor = nvim
eol = lf
excludesfile = ~/.gitignore
pager = delta --paging=auto
safecrlf = true

[pager]
diff = delta
log = delta
reflog = delta
show = delta
difftool = true

[delta]
    features = flexoki-dark
    syntax-theme = none
    dark = true
    navigate = true
    side-by-side = true
    line-numbers = true
    true-color = always
    hyperlinks = true
    keep-plus-minus-markers = false

# The *-non-emph-style / *-emph-style spellings are delta's real option names.
# The -non-current-/-emphasized- variants read naturally but do not exist, and
# delta ignores an unknown key in git config without warning, so intra-line
# emphasis silently falls back to defaults instead of these colours.
[delta "flexoki-dark"]
    minus-style = "#AF3029" bold "#281717"
    minus-non-emph-style = "#AF3029" "#281717"
    minus-emph-style = bold "#D14D41" "#3D1F1F"
    plus-style = "#66800B" bold "#1A2414"
    plus-non-emph-style = "#66800B" "#1A2414"
    plus-emph-style = bold "#879A39" "#23331B"
    line-numbers-minus-style = "#AF3029"
    line-numbers-plus-style = "#66800B"
    line-numbers-zero-style = "#6F6E69"
    whitespace-error-style = "#AF3029" reverse

[delta "decorations"]
commit-decoration-style = bold yellow box ul
file-style = bold yellow ul
file-decoration-style = none
hunk-header-decoration-style = yellow box

[interactive]
diffFilter = delta --color-only

[diff]
algorithm = histogram
colorMoved = zebra
colorMovedWS = allow-indentation-change
mnemonicPrefix = true
renames = true
context = 10
indentHeuristic = true
wsErrorHighlight = all
tool = difftastic

[difftool]
prompt = false

[difftool "difftastic"]
cmd = difft "$LOCAL" "$REMOTE"

[diff-so-fancy]
changeHunkIndicators = true
markEmptyLines = false
rulerWidth = 80
stripLeadingSymbols = true

[merge]
conflictStyle = zdiff3
log = true
tool = nvimdiff

[mergetool]
prompt = false
keepBackup = false

[pull]
rebase = true
ff = only

[rebase]
autoStash = true
autosquash = true
updateRefs = true

[rerere]
enabled = true
autoUpdate = true

[fetch]
prune = true
pruneTags = true
all = true

[push]
autoSetupRemote = true
default = simple
followTags = true

[branch]
autoSetupMerge = always
sort = -committerdate

[commit]
cleanup = strip
verbose = true

[status]
showUntrackedFiles = all

[log]
date = iso

[format]
pretty = fuller

[tag]
sort = version:refname

[apply]
whitespace = fix

[init]
defaultBranch = main

[help]
autocorrect = prompt

[url "https://"]
insteadOf = git://

[hub]
protocol = https

[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true

[alias]
dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order
