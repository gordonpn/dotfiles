zsh_plugins=${ZDOTDIR:-~}/.zsh_plugins
# Ensure ghostty's shell-integration loads in re-invoked shells (exec zsh, sudo -E zsh, etc.).
# Without this, the ssh wrapper that auto-installs xterm-ghostty terminfo on remotes is lost.
if [[ -n $GHOSTTY_RESOURCES_DIR ]]; then
  source "$GHOSTTY_RESOURCES_DIR"/shell-integration/zsh/ghostty-integration
fi

# Ensure environment variables from .zprofile are available in interactive subshells
if [[ -z "$ANTHROPIC_BASE_URL" && -f "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprofile"
fi

[[ -f ${zsh_plugins}.txt ]] || touch ${zsh_plugins}.txt

fpath=(${ZDOTDIR:-~}/.antidote/functions $fpath)
autoload -Uz antidote

if [[ ! ${zsh_plugins}.zsh -nt ${zsh_plugins}.txt ]]; then
  antidote bundle <${zsh_plugins}.txt >|${zsh_plugins}.zsh
fi

# History Configuration
# zephyr's history plugin always assigns HISTFILE, so pin it with a zstyle
# instead of assigning here. Keeps the existing history file.
zstyle ':zephyr:plugin:history' histfile "$HOME/.zsh_history"
HISTSIZE=10000000
SAVEHIST=$HISTSIZE

# Zsh Options
setopt EXTENDED_GLOB
setopt GLOB_DOTS
export COLORTERM="truecolor"
setopt AUTO_CD
setopt CORRECT
setopt INTERACTIVE_COMMENTS
setopt appendhistory
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt PUSHD_TO_HOME
setopt PUSHD_MINUS

# FAST: Check typical locations without spawning the 'brew' process
if [[ -d "/opt/homebrew/share/zsh-completions" ]]; then
  FPATH="/opt/homebrew/share/zsh-completions:$FPATH"
elif [[ -d "/usr/local/share/zsh-completions" ]]; then
  FPATH="/usr/local/share/zsh-completions:$FPATH"
elif [[ -d "/home/linuxbrew/.linuxbrew/share/zsh-completions" ]]; then
  FPATH="/home/linuxbrew/.linuxbrew/share/zsh-completions:$FPATH"
fi

fpath=(~/.zfunc $fpath)

# compinit is owned by mattmc3/zephyr path:plugins/completion, which defers it to
# a post-.zshrc hook so the prompt draws before paying for it.

# Cache the compinit dumpfile. Invalidated on an fpath change or when any
# completion directory is touched, so a new tool is still picked up.
# Expansion Configuration for zsh-expand
export ZPWR_EXPAND_TO_HISTORY=true
export ZPWR_EXPAND=true
export ZPWR_EXPAND_SECOND_POSITION=true
typeset -ga ZPWR_EXPAND_BLACKLIST=(cd ls)
export ZPWR_EXPAND_PRE_EXEC_NATIVE=true
export ZPWR_EXPAND_ALL_POSITIONS=true
export ZPWR_EXPAND_BRACKETED_PASTE=true

source ${zsh_plugins}.zsh

# zephyr's history plugin sets NO_share_history; we want it on.
setopt SHARE_HISTORY

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# FZF Configuration
if command -v fzf >/dev/null; then
  # Use fd instead of find
  export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --strip-cwd-prefix --hidden --follow --exclude .git'

  # UI Improvements
  export FZF_DEFAULT_OPTS="
    --ansi
    --height 40%
    --border sharp
    --color=bg+:#222121,bg:#181616,spinner:#c8c093,hl:#c4746e \
    --color=fg:#c8c093,header:#c8c093,info:#717c7c,pointer:#7aa89f \
    --color=marker:#7aa89f,fg+:#dcd7ba,prompt:#7aa89f,hl+:#7aa89f
    --prompt='❯ '
    --pointer='▶'
    --marker='✓'
  "

  # CTRL-T: File preview with bat
  export FZF_CTRL_T_OPTS="
    --preview 'bat -n --color=always --colors=\"ui:less\" --line-range :500 {}'
    --bind 'ctrl-/:change-preview-window(down|hidden|)'
    --bind 'ctrl-d:preview-page-down,ctrl-u:preview-page-up'
    --multi
    --bind 'ctrl-o:execute(nvim {+})+abort'
  "

  # CTRL-R: History search with sorting and keybinds
  if [[ "$(uname)" == "Darwin" ]]; then
    export FZF_CTRL_R_OPTS="--scheme=history --preview 'echo {}' --preview-window down:3:hidden:wrap --bind 'ctrl-y:execute-silent(echo -n {2..} | pbcopy)+abort' --header 'Press CTRL-Y to copy command'"
  else
    export FZF_CTRL_R_OPTS="--scheme=history --preview 'echo {}' --preview-window down:3:hidden:wrap --bind 'ctrl-y:execute-silent(echo -n {2..} | xclip -sel clip)+abort' --header 'Press CTRL-Y to copy command'"
  fi

  # ALT-C: Directory preview with eza
  export FZF_ALT_C_OPTS="--preview 'eza -T --color=always {} | head -200'"

  # Advanced completions helper functions
  _fzf_compgen_path() {
    fd --hidden --follow --exclude ".git" . "$1"
  }

  _fzf_compgen_dir() {
    fd --type d --hidden --follow --exclude ".git" . "$1"
  }
fi

# LS_COLORS setup with caching for performance (inspired by local/.zshrc)
if [[ ! -f ~/.ls_colors_cache ]]; then
  if command -v vivid >/dev/null; then
    vivid generate ansi > ~/.ls_colors_cache
  fi
fi
[[ -f ~/.ls_colors_cache ]] && export LS_COLORS=$(<~/.ls_colors_cache)

setopt MENU_COMPLETE
zstyle ':omz:update' mode auto
zstyle ':completion:*' menu no
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' verbose yes
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:functions' ignored-patterns '(_*|pre(cmd|exec))'
zstyle ':completion:*:*:*:*:processes' command "ps -u $USER -o pid,user,comm,cmd -w -w"
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#) ([0-9a-z-]#)*=01;34=0=01'
zstyle ':fzf-tab:*' switch-group ',' '.'
zstyle ':fzf-tab:complete:kill:argument-rest' extra-opts --preview='ps --pid=$in[(w)1] -o cmd --no-headers -w -w' --preview-window=down:3:wrap
zstyle ':fzf-tab:*' fzf-flags \
  --height=35% \
  --preview-window=right:60% \
  --color='bg+:#222121,bg:#181616,spinner:#c8c093,hl:#c4746e' \
  --color='fg:#c8c093,header:#c8c093,info:#717c7c,pointer:#7aa89f' \
  --color='marker:#7aa89f,fg+:#dcd7ba,prompt:#7aa89f,hl+:#7aa89f' \
  --bind='ctrl-d:preview-page-down,ctrl-u:preview-page-up'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:*:*' fzf-preview '
  if [ -d $realpath ]; then
    eza -1 --color=always $realpath
  else
    bat --color=always --line-range :500 $realpath 2>/dev/null || cat $realpath
  fi'
zstyle ':fzf-tab:complete:(-command-|-parameter-|-brace-parameter-|export|unset|alias):*' fzf-preview 'echo ${(P)word}'
zstyle ':fzf-tab:complete:git-(add|diff|restore):*' fzf-preview 'git diff $word | delta'
zstyle ':fzf-tab:complete:git-log:*' fzf-preview 'git log --color=always $word'
zstyle ':fzf-tab:complete:git-show:*' fzf-preview 'git show --color=always $word | delta'
zstyle ':fzf-tab:complete:git-checkout:*' fzf-preview 'git show --color=always $word | delta'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/.zcompcache"

# 1) exact match first
# 2) then case-insensitive
# 3) then flex on separators like . _ -
# 4) then substring-ish matching
zstyle ':completion:*' matcher-list \
  '' \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'

zshaddhistory() {
  setopt LOCAL_OPTIONS
  setopt EXTENDED_GLOB

  local cmd="$1"

  # 1. Flatten lines explicitly split with a backslash \
  cmd="${cmd//\\$'\n'/ }"

  # 2. Trim leading (left) and trailing (right) whitespace/newlines
  cmd="${cmd##[[:space:]]#}"
  cmd="${cmd%%[[:space:]]#}"

  # If the command is completely empty after cleaning, drop it
  [[ -z "$cmd" ]] && return 1

  # 3. Save your clean command using your raw (-r) print setup
  print -sr -- "$cmd"
  fc -p "$HISTFILE"
  
  return 1
}

bracketed-paste() {
  zle .$WIDGET && LBUFFER=${LBUFFER%$'\n'}
}
zle -N bracketed-paste

autoload -Uz edit-command-line
zle -N edit-command-line

# Key Bindings
# History navigation with FZF
bindkey "$terminfo[kcuu1]" fzf-history-widget
bindkey "$terminfo[kcud1]" fzf-history-widget
bindkey '^[[A' fzf-history-widget
bindkey '^[[B' fzf-history-widget
bindkey '^[OA' fzf-history-widget
bindkey '^[OB' fzf-history-widget
bindkey '^R' fzf-history-widget

# Autosuggest acceptance
bindkey '^ ' autosuggest-accept

# Edit command line
# Insert Mode: Ctrl+v
bindkey -M viins '^v' edit-command-line
# Normal Mode: v (Standard Vi behavior)
bindkey -M vicmd 'v' edit-command-line

TRAPINT() {
  zle && [[ $BUFFER ]] && print -s -- "$BUFFER"
  return $((128 + $1))
}

# Git Aliases
if [[ "$(uname)" == "Darwin" ]]; then
  source /Users/gordonpn/workspace/dotfiles/dotfiles/.git-aliases
elif [[ "$(uname)" == "Linux" ]]; then
  source /home/gordonpn/workspace/dotfiles/dotfiles/.git-aliases
fi

# bat — config lives at ~/.config/bat/config (symlinked from .batconfig in dotfiles)
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Suppress docker's promotional hints on every command
export DOCKER_CLI_HINTS=false

# Command Aliases
alias ls='eza -lah --group-directories-first --icons=always'
compdef ls=eza
alias cat='bat'
alias bathelp='bat --plain --language=help'
alias bless='bat --paging=always --style=plain'
alias grep='rg'
alias find='fd'
alias du='dust'
alias df='duf'
alias ps='procs'
# zj: attach to most recent LIVE zellij session, or start fresh if none.
# Skips EXITED sessions (dead-shell remnants from Ctrl+D etc.) — those would
# resurrect as a blank screen. Args are forwarded as-is (e.g. `zj kill-all-sessions`).
zj() {
    if (( $# > 0 )); then
        command zellij "$@"
        return
    fi
    local last
    last=$(command zellij list-sessions -r -n 2>/dev/null \
           | grep -v 'EXITED' \
           | awk 'NR==1 {print $1}')
    if [[ -n $last ]]; then
        command zellij attach "$last"
    else
        command zellij
    fi
}

# Auto-attach to (or create) 'polite-accordion' Zellij session on SSH logins
if [[ -z "$ZELLIJ" ]] && [[ -n "$SSH_TTY" ]] && (( $+commands[zellij] )); then
    exec zellij attach -c polite-accordion
fi

alias vi='nvim'
alias vim='nvim'
alias v='nvim'
alias vr='nvim -R'
alias repomix='pnpx repomix@latest'
alias qdrant="docker run --restart always -p 6333:6333 -v qdrant_storage:/qdrant/storage qdrant/qdrant"
alias treee='fd --type f --hidden --exclude .git | tree --fromfile'
alias tree='tree -a -I ".git|node_modules|.venv"'
alias gmi='gemini --skip-trust --approval-mode=yolo'
alias agy='agy --continue --dangerously-skip-permissions'
alias cpt='copilot --effort=max --allow-all --enable-memory --mode=plan --model=auto'
alias cld="claude --allow-dangerously-skip-permissions --continue --dangerously-skip-permissions --permission-mode=auto"
alias cldn="claude --allow-dangerously-skip-permissions --dangerously-skip-permissions --permission-mode=auto"
alias fullreboot='sudo reboot'
if [[ "$(uname)" == "Darwin" ]]; then
  alias softreboot="osascript -e 'tell app \"System Events\" to restart'"
  alias restartwifi='networksetup -setairportpower en0 off && networksetup -setairportpower en0 on'
  alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
fi

# AI/ML Aliases
# Use Flash for speed (Daily Driver)
alias ask="aichat -m deepseek-v4-flash"

# Use Pro for Reasoning (Architectural tasks)
alias reason="llm -m deepseek-v4-pro"

# The "Junior Developer" (Direct file editing)
alias dev='aider --model deepseek/deepseek-v4-pro --editor-model deepseek/deepseek-chat --architect --reasoning-effort high --dark-mode --no-attribute-author --no-attribute-committer --no-attribute-commit-message-author --no-attribute-commit-message-committer --no-attribute-co-authored-by --cache-prompts --commit-prompt "write single concern atomic conventional commits" --auto-accept-architect --yes-always --no-check-model-accepts-settings' 

# The "Log Parser" (Unix piping)
alias parse="mods --model deepseek-v4-flash"

# Custom Functions
pnpx() {
  if [ -f "node_modules/.bin/$1" ]; then
    pnpm exec "$@"
  else
    pnpm dlx "$@"
  fi
}

[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path zsh)"

# _zcache_source, shared with the work machines' .zshrc. Must be sourced before
# the tool inits below, which all go through it.
if [[ "$(uname)" == "Darwin" ]]; then
  source /Users/gordonpn/workspace/dotfiles/dotfiles/.zsh-init-cache
elif [[ "$(uname)" == "Linux" ]]; then
  source /home/gordonpn/workspace/dotfiles/dotfiles/.zsh-init-cache
fi

# mise emits only static `export PATH` lines here, so it caches cleanly. Bare
# name first so a Homebrew mise wins; the explicit path covers hosts where mise
# is installed but not yet on PATH at this point. Both write one cache entry.
if (( $+commands[mise] )); then
  _zcache_source mise mise mise activate zsh --shims
else
  _zcache_source mise ~/.local/bin/mise ~/.local/bin/mise activate zsh --shims
fi

# This forces zoxide to intercept the 'cd' command entirely
if (( $+commands[zoxide] )); then
  _zcache_source zoxide zoxide zoxide init zsh --cmd cd
fi
# starship is initialized by starship-ftl (see .zsh_plugins.txt), which uses instant
# prompt for local shells and falls back to standard starship init on SSH sessions.
eval "$(npm completion)"

# Background-fetch the current git repo on cd (rate-limited per repo).
# Lets starship's git_status show ⇣N when behind upstream without manual fetch.
# Override interval (seconds) with GIT_BG_FETCH_INTERVAL (default 600).
autoload -Uz add-zsh-hook
zmodload zsh/datetime 2>/dev/null

_git_bg_fetch() {
  git rev-parse --is-inside-work-tree &>/dev/null || return

  local fetch_head
  fetch_head=$(git rev-parse --git-path FETCH_HEAD 2>/dev/null) || return

  local now=${EPOCHSECONDS:-$(date +%s)} mtime=0
  if [[ -f $fetch_head ]]; then
    mtime=$(date -r "$fetch_head" +%s 2>/dev/null || echo 0)
  fi

  (( now - mtime < ${GIT_BG_FETCH_INTERVAL:-600} )) && return

  GIT_TERMINAL_PROMPT=0 git fetch --quiet --all --prune &>/dev/null &!
}

add-zsh-hook chpwd _git_bg_fetch


# Added by Antigravity CLI installer
export PATH="/Users/gordonpn/.local/bin:$PATH"

# carapace: multi-shell completion engine, fills in commands that ship no zsh
# completion of their own (docker, kubectl, curl, tar, ...).
# CARAPACE_EXCLUDES keeps the completions that beat carapace's generic ones:
# brew site-functions (bat eza fd gh rg zoxide), hand-written ~/.zfunc entries
# (lazygit starship), `npm completion`, and zsh's own _git and _ssh, which
# understand git aliases and ssh config Include directives respectively.
# Must run after compinit, which the antidote bundle handles.
if (( $+commands[carapace] )); then
  export CARAPACE_EXCLUDES='bat,eza,fd,gh,git,lazygit,npm,rg,ssh,starship,zoxide'
  _zcache_source carapace carapace carapace _carapace zsh
fi

# Cross-platform `sed -i`. GNU sed wants no suffix arg, BSD sed requires one, so
# ask which is installed. Matters here because GNU coreutils on PATH makes the
# answer machine-dependent. Lifted from mattmc3/zephyr plugins/utility.
sedi() {
  sed --version &>/dev/null && sed -i -- "$@" || sed -i "" "$@"
}

# mkdir -p plus cd in one step. Extracted from OMZ lib/functions.zsh rather than
# loading the whole lib, which also brings upgrade_oh_my_zsh and zsh_stats that
# mean nothing under antidote. OMZ's takeurl/takegit variants are left out.
take() {
  mkdir -p -- "$@" && cd -- "${@[-1]}"
}

# Syntax highlighting via zsh-patina (Rust daemon, replaces
# fast-syntax-highlighting). Must be activated last so it hooks ZLE after
# every other plugin. Guarded because this config is shared with hosts where
# patina isn't installed. It needs zsh >= 5.9.
(( $+commands[zsh-patina] )) && _zcache_source zsh-patina zsh-patina zsh-patina activate
